<div class="dc-specialty augmerc" data-source-range="452:453"><div class="dc-learning-path dc-path-block" data-path-ref="AUG1" data-source-range="454:455"><div class="dc-path-shell">
<h3 class="dc-spray"><span class="dc-path-sticker">AUG1</span><span class="dc-path-sep"> </span>Example Path</h3>
</div>
