<h2 data-name="inline-html">Inline HTML</h2>
<table>
<thead data-source-range="84:85">
<tr data-source-range="84:85">
<th>You write</th>
<th>Renders</th>
</tr>
</thead>
<tbody data-source-range="86:93">
<tr data-source-range="86:87">
<td><code>&lt;span class=&quot;dc-tag&quot;&gt;Melee&lt;/span&gt;</code></td>
